#!/usr/bin/env php
<?php

declare(strict_types=1);

// CLI wrapper: resolves the b4n1web binary and passes all arguments through
// (e.g. `b4n1web goto https://example.com --mode light`).

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',   // composer install
    __DIR__ . '/../../../autoload.php',    // global composer
];
$loaded = false;
foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}
if (!$loaded) {
    // Fallback: load classes directly (no composer install needed).
    spl_autoload_register(static function (string $class): void {
        $prefix = 'B4n1Web\\';
        if (!str_starts_with($class, $prefix)) {
            return;
        }
        $relative = substr($class, strlen($prefix));
        $file = __DIR__ . '/../src/B4n1Web/' . str_replace('\\', '/', $relative) . '.php';
        if (is_file($file)) {
            require $file;
        }
    });
}

use B4n1Web\Binary;

$binary = Binary::resolve();
if ($binary === null) {
    fwrite(STDERR, "ERROR: b4n1web binary not found.\n");
    fwrite(STDERR, "  Install: curl -sL https://raw.githubusercontent.com/B4N1-com/b4n1-web/master/scripts/install.sh | bash\n");
    fwrite(STDERR, "  Or set B4N1WEB_BIN_PATH to an existing binary.\n");
    exit(1);
}

$escaped = implode(' ', array_map('escapeshellarg', array_merge([$binary], $argv)));
passthru($escaped, $exitCode);
exit($exitCode);
