<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>B4N1Web</RootNamespace>
    <AssemblyName>B4n1Web</AssemblyName>
    <Version>0.15.0</Version>
    <Authors>Bani Montoya</Authors>
    <Email>banimontoya@gmail.com</Email>
    <Description>B4n1Web SDK for .NET - Agentic Browser Engine with bundled binary</Description>
    <PackageLicenseFile>BUSL-1.1.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>browser;automation;agent;AI;headless</PackageTags>
    <PackageProjectUrl>https://b4n1.com</PackageProjectUrl>
    <PackageIconUrl>https://b4n1.com/favicon.ico</PackageIconUrl>
    <Company>B4N1</Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="../../../BUSL-1.1.txt" Pack="true" PackagePath="\" />
    <None Include="EULA.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="native/linux-amd64/b4n1web">
      <LogicalName>B4N1Web.native.linux-amd64.b4n1web</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native/linux-arm64/b4n1web">
      <LogicalName>B4N1Web.native.linux-arm64.b4n1web</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native/macos-x64/b4n1web">
      <LogicalName>B4N1Web.native.macos-x64.b4n1web</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native/macos-arm64/b4n1web">
      <LogicalName>B4N1Web.native.macos-arm64.b4n1web</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native/windows-amd64/b4n1web.exe">
      <LogicalName>B4N1Web.native.windows-amd64.b4n1web.exe</LogicalName>
    </EmbeddedResource>
    <!-- windows-arm64: no se compila en local (sin Windows SDK, AGENTS.md §11.24).
         Condicional para no romper el pack cuando el binario no existe. -->
    <EmbeddedResource Include="native/windows-arm64/b4n1web.exe" Condition="Exists('native/windows-arm64/b4n1web.exe')">
      <LogicalName>B4N1Web.native.windows-arm64.b4n1web.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
