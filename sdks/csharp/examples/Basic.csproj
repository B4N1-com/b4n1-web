<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Example only: never packed. Belt-and-braces so an accidental pack is
         still licensed instead of falling back to no-license (§10k). -->
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\B4n1Web.csproj" />
  </ItemGroup>

</Project>
