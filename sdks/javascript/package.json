{
  "name": "b4n1-web",
  "version": "0.11.0",
  "description": "B4n1Web SDK for JavaScript/TypeScript - Agentic Browser Engine with bundled binary",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "browser",
    "agent",
    "automation",
    "web-scraping",
    "headless"
  ],
  "author": "Bani Montoya <banimontoya@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/B4N1-com/b4n1-web/issues"
  },
  "homepage": "https://b4n1.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/B4N1-com/b4n1-web.git"
  },
  "dependencies": {
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
